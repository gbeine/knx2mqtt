#!/usr/bin/env python

import asyncio
import importlib
import logging
import socket
import time
import traceback

import iot_daemonize
import iot_daemonize.configuration as configuration

from xknx import XKNX
from xknx.dpt.dpt import DPTArray, DPTBinary
from xknx.io.knxip_interface import ConnectionType, ConnectionConfig
from xknx.telegram.address import GroupAddress, IndividualAddress
from xknx.telegram.apci import GroupValueResponse, GroupValueWrite
from xknx.telegram import Telegram, TelegramDirection


XKNX_DPT_MODULE_STR = "xknx.dpt"


knx_tunnel = None
config = None
item_states = None


def get_dpt_type_for_address(group_address):
    global config

    dpt_type = None

    if group_address in config.dpt_types:
        dpt_type = config.dpt_types[group_address]

    return dpt_type


def extract_payload_from_telegram(group_address, telegram):
    dpt_type = get_dpt_type_for_address(group_address)
    payload = telegram.payload

    logging.info("Address: {}, DPT Type: {}, Payload: {}".format(group_address, dpt_type, payload))

    value = None

    try:
        if dpt_type == 'DPTBinary':
            value = int(bool(payload.value.value))
        else:
            if dpt_type is None:
                dpt_type = payload.value.__class__.__name__
            dpt_class = getattr(importlib.import_module(XKNX_DPT_MODULE_STR), dpt_type)
            value = dpt_class.from_knx(payload.value)
    except Exception as e:
        logging.error(traceback.format_exc())

    return value


def create_payload_for_telegram(group_address, value):
    dpt_type = get_dpt_type_for_address(group_address)

    logging.info("Address: {}, DPT Type: {}, Value: {}".format(group_address, dpt_type, value))

    payload = None

    try:
        if dpt_type == 'DPTBinary':
            payload = DPTBinary(int(str(value).lower() in ['true', '1', 'on', 'yes']))
        else:
            dpt_class = getattr(importlib.import_module(XKNX_DPT_MODULE_STR), dpt_type)
            payload = dpt_class.to_knx(value)
    except Exception as e:
        logging.error(traceback.format_exc())

    return payload


def publish_to_knx(address, payload):
    global config, knx_tunnel

    logging.info("Address: {}, Payload: {}".format(address, payload))

    source_address = IndividualAddress(config.knx_individual_address)
    group_address = GroupAddress(address)
    group_value = GroupValueWrite(payload)

    telegram = Telegram(
        destination_address=group_address,
        direction=TelegramDirection.OUTGOING,
        payload=group_value,
        source_address=source_address
    )

    if knx_tunnel.started:
        if config.knx_no_queue:
            asyncio.run(knx_tunnel.telegram_queue.process_telegram_outgoing(telegram))
        else:
            asyncio.run(knx_tunnel.telegrams.put(telegram))


def publish_to_mqtt(address, value):
    global item_states

    topic = "{}/{}".format(config.mqtt_topic, address)

    item_states[address] = str(value)

    logging.info("Topic: {}, Payload: {}".format(topic, value))
    iot_daemonize.mqtt_client.publish(topic, str(value))


def on_telegram_received(telegram):
    try:
        if telegram.direction != TelegramDirection.INCOMING:
            return

        # GroupValueRead carries no value; only writes and responses can be published.
        if not isinstance(telegram.payload, (GroupValueResponse, GroupValueWrite)):
            logging.debug("ignoring telegram because it's not of type GroupValueResponse or GroupValueWrite: {}".format(telegram.payload))
            return

        group_address = str(telegram.destination_address)
        payload = extract_payload_from_telegram(group_address, telegram)

        publish_to_mqtt(group_address, payload)
    except Exception as e:
        logging.error(traceback.format_exc())


def on_mqtt_connect(client, userdata, flags, reason_code, properties):
    global config

    for address in config.mqtt_subscribe:
        topic = "{}/{}".format(config.mqtt_topic, address)
        logging.info("Subscribe: {}".format(topic))
        client.subscribe(topic)


def on_mqtt_received(client, userdata, message):
    global config, item_states

    try:
        group_address = message.topic.replace("{}/".format(config.mqtt_topic), '')
        value = str(message.payload.decode())

        if item_states[group_address] == value:
            logging.info("Received value for {} is last state sent: {}".format(group_address, value))
            return

        payload = create_payload_for_telegram(group_address, value)

        publish_to_knx(group_address, payload)
    except Exception as e:
        logging.error(traceback.format_exc())


def start_knx():
    global config

    connection_config = ConnectionConfig(
            connection_type=ConnectionType.TUNNELING,
            local_ip=config.knx_local_ip,
            gateway_ip=socket.gethostbyname(config.knx_host),
            gateway_port=config.knx_port
        )

    async def run():
        global knx_tunnel
        knx_tunnel = XKNX(daemon_mode=True, connection_config=connection_config)
        knx_tunnel.telegram_queue.register_telegram_received_cb(
            telegram_received_cb=on_telegram_received,
            group_addresses=config.knx_subscribe
        )
        await knx_tunnel.start()
        await knx_tunnel.stop()

    asyncio.run(run())


def init_items():
    global config, item_states

    config.dpt_types = {}
    config.mqtt_subscribe = []
    config.knx_subscribe = []
    item_states = {}

    if config.items is None:
        return

    for item in config.items:
        if not 'knx_subscribe' in item:
            item['knx_subscribe'] = True
        if not 'mqtt_subscribe' in item:
            item['mqtt_subscribe'] = False

        if 'address' in item:
            item_states[item['address']] = None

            if 'type' in item:
                config.dpt_types[item['address']] = item['type']
            if item['mqtt_subscribe']:
                config.mqtt_subscribe.append(item['address'])
            if item['knx_subscribe']:
                config.knx_subscribe.append(GroupAddress(item['address']))


def main():
    global config

    config = configuration.MqttDaemonConfiguration(
        program='knx2mqtt',
        description='A KNX to MQTT bridge')
    config.add_config_arg('mqtt_clientid', flags='--mqtt_clientid', default='knx2mqtt',
                     help='The clientid to send to the MQTT server. Default is knx2mqtt.')
    config.add_config_arg('mqtt_topic', flags='--mqtt_topic', default='bus/knx',
                     help='The topic to publish MQTT message. Default is bus/knx.')
    config.add_config_arg('knx_host', flags=['-k', '--knx_host'], default='localhost',
                     help='The hostname of the KNX gateway. Default is localhost.')
    config.add_config_arg('knx_port', flags=['--knx_port'], default=3671,
                     help='The port of the KNX gateway. Default is 3671.')
    config.add_config_arg('knx_local_ip', flags=['--knx_local_ip'],
                     help='The local ip address to connect the KNX gateway.')
    config.add_config_arg('knx_individual_address', flags=['--knx_individual_address'],
                     default='15.15.248',
                     help='The group address to send KNX telegrams from. Default is 15.15.248.')
    config.add_config_arg('knx_no_queue', flags=['--knx_no_queue'], default=False,
                     action='store_true',
                     help='Disable XKNX telegram queuing.')
    config.add_config_arg('config', flags=['-c', '--config'], default='/etc/knx2mqtt.conf',
                     help='The path to the config file. Default is /etc/knx2mqtt.conf.')
    config.add_config_arg('items',
                     help='The KNX items configuration.')
    config.parse_args()
    config.parse_config(config.config)

    iot_daemonize.init(config, mqtt=True)

    init_items()

    # Set MQTT callbacks for bidirectional communication
    iot_daemonize.mqtt_client._mqtt_client.on_connect = on_mqtt_connect
    iot_daemonize.mqtt_client._mqtt_client.on_message = on_mqtt_received

    iot_daemonize.run()
    start_knx()


if __name__ == "__main__":
    main()
